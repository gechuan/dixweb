---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import podcast from '../data/podcast.json';
import { shortDate } from '../lib/dates';

const external = { target: '_blank', rel: 'noopener noreferrer' };
const episodes = [...podcast.episodes].sort((a, b) => b.date.localeCompare(a.date));
const showUrl = podcast.show.platforms[0]?.url ?? site.social.podcast;
---

<Layout title={`播客 · ${site.brand}`} description={podcast.show.description} image={podcast.show.cover}>
  <header class="page-head">
    <div class="wrap">
      <div class="sec-eyebrow"><span class="dot"></span>PODCAST · 播客</div>
      <h1>{podcast.show.name}</h1>
      <p class="page-updated">{podcast.show.eyebrow} · 主理人 {podcast.show.hosts.join('、')}</p>
      <div class="prose page-intro"><p>{podcast.show.description}</p></div>
    </div>
  </header>

  <section class="page-section podcast-show">
    <div class="wrap">
      <div class="show-summary">
        <picture>
          <source type="image/webp" srcset="/assets/fanshuba-cover-480.webp 480w, /assets/fanshuba-cover-960.webp 960w" sizes="(max-width: 860px) 96vw, 280px" />
          <img src={podcast.show.cover} width="960" height="960" alt="《翻书吧》节目封面" />
        </picture>
        <div>
          <div class="platform-links">
            {podcast.show.platforms.map((platform) => (
              <a class="btn primary" href={platform.url} {...external}>在{platform.label}收听</a>
            ))}
          </div>
          <p>单集更新会在这里保留完整标题、日期和节目摘要。</p>
        </div>
      </div>

      <div class="reading-list">
        {episodes.map((episode) => (
          <a class="reader-item" href={episode.url || showUrl} {...external}>
            <time class="reader-date" datetime={episode.date}>{shortDate(episode.date)}</time>
            <span class="reader-body">
              <strong>{episode.title}</strong>
              <span>{episode.summary}</span>
            </span>
            <span class="reader-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
