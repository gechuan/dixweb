---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import about from '../data/about.json';
import { isoDate } from '../lib/dates';

const updated = isoDate();
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<Layout title={`关于 · ${site.brand}`} description={about.lede.replace(/<[^>]*>/g, '')}>
  <header class="page-head">
    <div class="wrap">
      <div class="sec-eyebrow"><span class="dot"></span>{about.eyebrow}</div>
      <h1>{about.title}</h1>
      <p class="page-updated">更新于 <time class="latin" datetime={updated}>{updated}</time></p>
    </div>
  </header>

  <section class="page-section">
    <div class="wrap about-page">
      <div>
        <div class="prose">
          <p class="lead" set:html={about.lede.replace(/<em>/g, '<span class="em">').replace(/<\/em>/g, '</span>')} />
          {about.paragraphs.map((paragraph) => <p set:html={paragraph.replace(/<em>/g, '<span class="em">').replace(/<\/em>/g, '</span>')} />)}
        </div>

        <section class="doing">
          <div class="sec-eyebrow"><span class="dot"></span>DOING · 我在做什么</div>
          {about.doing.map((item) => (
            <p><strong>{item.label}</strong><span set:html={item.text} /></p>
          ))}
        </section>
      </div>

      <aside class="contact-card">
        <h2>合作与联系</h2>
        <div class="links">
          {about.links.map((link) =>
            link.action === 'follow' ? (
              <button type="button" data-modal-open="follow">{link.label}</button>
            ) : (
              <a href={link.href} {...external}>{link.label}</a>
            )
          )}
        </div>
        <p>欢迎就播客、项目和内容合作联系我。</p>
      </aside>
    </div>
  </section>
</Layout>
