---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
---

<Layout title={`页面不存在 · ${site.brand}`}>
  <section class="notfound">
    <div class="wrap">
      <div class="code latin">404</div>
      <h1>这一页还没写</h1>
      <p>地址可能变了，或者它从来就不存在。回首页看看最新在做的吧。</p>
      <div class="page-actions">
        <a class="btn-primary" href="/">回首页</a>
        <a class="btn-ghost" href="/projects">看看项目</a>
      </div>
    </div>
  </section>
</Layout>
