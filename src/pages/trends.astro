---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import trends from '../data/trends.json';

const external = { target: '_blank', rel: 'noopener noreferrer' };
const total = trends.sources.reduce((sum, source) => sum + source.items.length, 0);
const filters = [
  { key: 'all', label: '全部', count: total },
  ...trends.sources.map((source) => ({ key: source.id, label: source.title, count: source.items.length })),
];
---

<Layout title={`探索 · ${site.brand}`} description="看研究、产品和开源项目的最新趋势。数据来自 Hugging Face Papers、Product Hunt 与 GitHub Trending。">
  <header class="page-head">
    <div class="wrap">
      <div class="sec-eyebrow"><span class="dot"></span>TRENDS · 探索</div>
      <h1>看新技术和产品正在流向哪里</h1>
      <div class="prose page-intro"><p>Hugging Face 看研究，Product Hunt 看产品，GitHub 看工程。三个信号放在一起看。</p></div>
      <p class="page-stats">
        <span><b class="latin" data-project-count>{total}</b> 条趋势</span>
        <span>更新于 <b>{trends.updatedAt}</b></span>
      </p>
    </div>
  </header>

  <section class="page-section">
    <div class="wrap">
      <div class="filter-bar" data-project-filters role="toolbar" aria-label="按趋势来源筛选">
        {filters.map((filter, index) => (
          <button type="button" class={index === 0 ? 'chip active' : 'chip'} data-filter={filter.key} aria-pressed={index === 0 ? 'true' : 'false'}>
            {filter.label} <span class="latin">{filter.count}</span>
          </button>
        ))}
      </div>

      <div data-project-grid>
        {trends.sources.map((source) => (
          <section class="source-group" id={source.id} data-project-group aria-labelledby={`trend-${source.id}`}>
            <header>
              <h2 id={`trend-${source.id}`}>{source.title}</h2>
              <span class="latin">{source.items.length}</span>
              <a class="more" href={source.href} {...external}>查看来源</a>
            </header>
            <p>{source.note}</p>
            <div class="project-grid trend-grid">
              {source.items.map((item) => (
                <a class="project-card" href={item.href} {...external} data-category={source.id}>
                  <div>
                    <h3>{item.title}</h3>
                    <span class="badge">{item.date}</span>
                  </div>
                  <p>{item.summary}</p>
                  <span class="project-link">{item.meta} <span aria-hidden="true">↗</span></span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>
