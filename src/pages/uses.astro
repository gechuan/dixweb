---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import uses from '../data/uses.json';
---

<Layout title={`工具箱 · ${site.brand}`} description={uses.lede}>
  <header class="page-head">
    <div class="wrap">
      <div class="sec-eyebrow"><span class="dot"></span>{uses.eyebrow}</div>
      <h1>{uses.title}</h1>
      <div class="prose page-intro"><p>{uses.lede}</p></div>
      <p class="page-updated">更新于 {uses.updated}</p>
    </div>
  </header>
  <section class="page-sec">
    <div class="wrap">
      <div class="uses-groups">
        {uses.groups.map((group) => (
          <div class="uses-group">
            <h2>{group.title}</h2>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noopener noreferrer">{item.name}</a>
                  <p>{item.desc}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
