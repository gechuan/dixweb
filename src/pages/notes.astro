---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import notes from '../data/notes.json';

const slug = (id: string) => id.replace(/^n-/, '');
---

<Layout title={`随想 · ${site.brand}`} description={notes.lede}>
  <header class="page-head">
    <div class="wrap">
      <div class="sec-eyebrow"><span class="dot"></span>Notes</div>
      <h1>随想</h1>
      <p class="page-lede">{notes.lede}</p>
      <a class="more" href={site.social.rss}>RSS 订阅</a>
    </div>
  </header>
  <section class="sec page-sec">
    <div class="wrap notes-wrap">
      <div class="notes" id="notes-list">
        {notes.entries.map((entry) => (
          <article class="note" id={entry.id} data-slug={slug(entry.id)}>
            <header class="note-head">
              <img class="note-avatar" src={site.avatar} width="40" height="40" alt="" loading="lazy" />
              <div class="note-byline">
                <span class="note-author">{entry.author}</span>
                <a class="note-date" href={`/notes/${slug(entry.id)}`}>
                  <time datetime={entry.datetime} title={entry.datelabel}>{entry.datelabel}</time>
                </a>
              </div>
              <div class="note-tools">
                <button
                  class="ui-icon-button"
                  type="button"
                  data-copy-link={`${site.siteUrl}/notes/${slug(entry.id)}/`}
                  aria-label="复制链接"
                  title="复制链接"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                  </svg>
                </button>
              </div>
            </header>
            <div class="note-body prose" set:html={entry.html} />
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-copy-link]');
    if (!btn) return;
    navigator.clipboard.writeText(btn.dataset.copyLink || '').then(() => {
      btn.setAttribute('title', '已复制');
      setTimeout(() => btn.setAttribute('title', '复制链接'), 1600);
    });
  });
</script>
