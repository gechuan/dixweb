---
import '../styles/global.css';
import site from '../data/site.json';
import podcast from '../data/podcast.json';
import fontManifest from '../data/font-manifest.json';
import { isoWeek, longDate } from '../lib/dates';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  image = podcast.show.cover,
  structuredData = [],
} = Astro.props;

const dateLabel = longDate();
const currentWeek = isoWeek();
const latestEpisode = [...podcast.episodes].sort((a, b) => b.date.localeCompare(a.date))[0];
const serifFontUrl = `/fonts/${fontManifest.serifSc}`;
const fontFaceCss = `@font-face{font-family:'Noto Serif SC';font-style:normal;font-weight:600;font-display:swap;src:url('${serifFontUrl}') format('woff2');size-adjust:96%;ascent-override:92%;descent-override:28%}@font-face{font-family:'Newsreader';font-style:normal;font-weight:400 700;font-display:swap;src:url('/fonts/newsreader-latin.woff2') format('woff2')}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const absoluteImage = new URL(image, Astro.site);
const isCurrent = (href: string) => {
  if (href.startsWith('http')) return false;
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  const current = Astro.url.pathname.replace(/\/$/, '') || '/';
  return base === '/' ? current === '/' : current === base || current.startsWith(`${base}/`);
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <link rel="preload" href={serifFontUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaceCss} />
    <script is:inline>
      try { const theme = localStorage.getItem('theme'); if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme; } catch {}
      document.documentElement.classList.add('js');
    </script>
    {site.umami?.src && site.umami?.websiteId && (
      <script is:inline defer src={site.umami.src} data-website-id={site.umami.websiteId}></script>
    )}
    {structuredData.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body data-qr-follow="/assets/qr-follow.png" data-qr-reward="/assets/qr-reward.png" data-github={site.social.github} data-x={site.social.x}>
    <a class="skip-link" href="#main">跳到主要内容</a>

    <header class="mast" id="mast">
      <div class="wrap mast-grid">
        <div class="mast-date">
          <span data-current-date>{dateLabel}</span>
          <span class="latin muted" data-current-week>Week {currentWeek}</span>
          <a class="date-episode" href={latestEpisode.url} target="_blank" rel="noopener noreferrer">本周播客 翻书吧</a>
        </div>
        <a class="brand" href="/" aria-label={`${site.brand} · 回到首页`}>
          <img class="avatar" src={site.logo} width="48" height="48" alt="" />
          <span class="wm">{site.brand}</span>
        </a>
        <div class="tools">
          {site.features.reward && (
            <button class="icon-btn reward" type="button" data-modal-open="reward" aria-label="打赏支持" title="打赏支持">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"></path></svg>
            </button>
          )}
          <a class="icon-btn" href={site.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.4-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.4c2.9-.3 6-1.4 6-6.4a5 5 0 0 0-1.4-3.5 4.6 4.6 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.3 12.3 0 0 0-6.4 0C6.1 1.4 5 1.7 5 1.7a4.6 4.6 0 0 0-.1 3.5 5 5 0 0 0-1.4 3.5c0 5 3.1 6.1 6 6.4a3 3 0 0 0-.9 2.4V21"></path></svg>
          </a>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="切换深色模式" title="切换深色模式">
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="navbar" id="navbar">
      <div class="wrap navbar-grid">
        <a class="mini" href="/" tabindex="-1" aria-hidden="true">
          <img class="avatar small" src={site.logo} width="28" height="28" alt="" />{site.brand}
        </a>
        <nav class="nav" aria-label="主导航" data-nav-scroll>
          {site.nav.map((item) => {
            const external = item.href.startsWith('http');
            return (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.label}{external && <span className="external-mark" aria-hidden="true">↗</span>}
              </a>
            );
          })}
        </nav>
        <button class="sub-btn" type="button" data-modal-open="follow">订阅</button>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="colo">
          <b><img class="avatar small" src={site.logo} width="28" height="28" alt="" loading="lazy" />{site.brand}</b>
          <span>{site.tagline}</span>
        </div>
        <nav aria-label="内容链接">
          <p class="foot-title">内容</p>
          <ul>
            <li><a href={site.social.blog} target="_blank" rel="noopener noreferrer">{site.social.blogLabel} <span aria-hidden="true">↗</span></a></li>
            <li><a href="/trends">探索</a></li>
            <li><a href="/podcast">播客</a></li>
            <li><a href="/rss">资讯</a></li>
          </ul>
        </nav>
        <nav aria-label="关于链接">
          <p class="foot-title">关于</p>
          <ul>
            <li><a href="/about">关于我</a></li>
            <li><button type="button" data-modal-open="follow">公众号「Deep Into X」</button></li>
            <li><a href={site.social.x} target="_blank" rel="noopener noreferrer">X @gechuan</a></li>
            {site.features.reward && <li><button type="button" data-modal-open="reward">打赏支持</button></li>}
          </ul>
        </nav>
      </div>
      <div class="foot-b">
        <div class="wrap">
          <span>{site.footer.copyright}</span>
          <a href={site.footer.coloUrl} target="_blank" rel="noopener noreferrer" title="阅读 Web 2.0 Next 宣言">{site.footer.colo}</a>
        </div>
      </div>
    </footer>

    <div class="modal-layer" data-modal-layer hidden>
      <div class="modal-backdrop" data-modal-close></div>
      <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title" tabindex="-1">
        <button class="modal-close" type="button" data-modal-close aria-label="关闭">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
        </button>
        <div data-modal-content></div>
      </section>
    </div>

    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
